{
  "name": "dsh-tlpro-models",
  "version": "1.0.1",
  "private": true,
  "description": "TLPro gateway routes and model catalog for DSH, as a bundle patch layer. Ships no code and never edits the DSH checkout.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungcsnd1133/dsh-tlpro-models.git"
  },
  "files": [
    "cordis.patch.yml",
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
